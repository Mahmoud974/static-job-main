
FROM node:20-alpine

WORKDIR /data

# Installer une version stable de JSON Server
RUN npm install -g json-server@0.17.4

# Copier les données
COPY src/assets/db.json /data/db.json

# Exposer le port API
EXPOSE 3004

# Démarrer JSON Server
CMD ["json-server", "--watch", "/data/db.json", "--host", "0.0.0.0", "--port", "3004"]
